{
  "manifest_version": 3,

  "name": "ANTIGRAVITY AI Stylist",

  "version": "2.0",

  "description": "AI Visual Outfit Designer",

  "permissions": [],

  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "https://api.groq.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://*/*"],

      "js": ["content.js"],

      "css": ["style.css"]
    }
  ]
}